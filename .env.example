# LifeOS — environment variables
# Copy this file to ".env" and fill in your Supabase project values.
# (Alternatively, skip this file and enter the values on the in-app Setup screen.)

# Supabase project URL — Project Settings → API → "Project URL"
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — Project Settings → API → "anon public"
# Safe to ship in the client; Row Level Security protects all data.
VITE_SUPABASE_ANON_KEY=your-anon-key

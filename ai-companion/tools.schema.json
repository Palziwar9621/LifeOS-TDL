[
 {
  "type": "function",
  "function": {
   "name": "add_task",
   "description": "Create one regular task (lives in Today/Tasks; completed with complete_task). Resolve dates locally; ask if time is ambiguous.",
   "parameters": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 120
     },
     "due_date": {
      "type": [
       "string",
       "null"
      ],
      "format": "date"
     },
     "due_time": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
     },
     "priority": {
      "type": "string",
      "enum": [
       "low",
       "medium",
       "high",
       "urgent"
      ]
     },
     "remind_me": {
      "type": "boolean"
     },
     "reminder_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10080
     },
     "project_hint": {
      "type": "string",
      "maxLength": 120
     }
    },
    "required": [
     "title"
    ],
    "additionalProperties": false
   }
  }
 },
 {

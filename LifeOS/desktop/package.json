{
  "name": "lifeos-desktop",
  "version": "1.1.0",
  "description": "LifeOS desktop app — wraps the LifeOS PWA for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.lifeos.desktop",
    "productName": "LifeOS",
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],    "win": {
      "target": ["portable", "nsis"],
      "icon": "icon.png",
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
